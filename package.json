{
  "name": "life-table-km",
  "version": "1.0.0",
  "private": true,
  "description": "Kaplan-Meier survival curves, censoring analysis and log-rank tests with SQLite (CLI + API only)",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
